# The raster tile source. URL and attribution are one setting in two parts -- point the URL at
# another provider without changing the credit and the map cites the wrong one, which is a
# licensing problem rather than a cosmetic one.
# OpenStreetMap's public tiles are served best-effort under the OSMF tile usage policy and suit a
# demo, not traffic: https://operations.osmfoundation.org/policies/tiles/
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
