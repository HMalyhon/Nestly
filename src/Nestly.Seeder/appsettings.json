{
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "IndexName": "listings"
  },
  "Embedding": {
    "ModelDirectory": "models",
    "ModelFile": "all-MiniLM-L6-v2.onnx",
    "VocabFile": "vocab.txt",
    "MaxTokens": 256,
    "BatchSize": 32
  },
  "Seeder": {
    "DataPath": "data/listings.csv.gz",
    "BatchSize": 500
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
