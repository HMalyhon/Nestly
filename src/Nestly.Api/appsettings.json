{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080"
      }
    }
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "IndexName": "listings"
  },
  "Embedding": {
    "ModelDirectory": "models",
    "ModelFile": "all-MiniLM-L6-v2.onnx",
    "VocabFile": "vocab.txt",
    "MaxTokens": 256,
    "BatchSize": 32
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
