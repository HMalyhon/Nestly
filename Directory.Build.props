<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning that reaches main is a warning nobody will ever fix. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!--
      Audit transitive packages too, not just the ones declared here: a vulnerability almost never
      arrives in a package this repo names directly.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <!--
      The one class of warning that is not allowed to fail the build. NU1901-NU1904 are advisories
      published against packages, so treating them as errors means an advisory filed overnight
      breaks a build whose code nobody has touched. It should report, loudly, and let someone
      decide; a red build for a reason no commit caused is a red build people learn to ignore.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    StyleCop covers layout and naming; Sonar covers bug patterns, dead code and complexity.
    They overlap very little, so both earn their place. Applied solution-wide here rather than
    per project so a new csproj is analysed the moment it is created.

    PrivateAssets="all" keeps them out of any package this repo might produce - they are build
    tooling, not a dependency of the shipped code.
  -->
  <ItemGroup Label="Analyzers">
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

</Project>
