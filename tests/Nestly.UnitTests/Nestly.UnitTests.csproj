<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Microsoft.Testing.Platform runs each test project as its own executable, rather than
         hosting it under a separate VSTest process. -->
    <OutputType>Exe</OutputType>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Nestly.Api/Nestly.Api.csproj" />
    <ProjectReference Include="../../src/Nestly.Search/Nestly.Search.csproj" />
    <ProjectReference Include="../../src/Nestly.Seeder/Nestly.Seeder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
